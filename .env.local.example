# Copy to .env.local and fill in real values. Never commit .env.local.

# Firebase project config — Firebase Console → Project settings → General → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Maps — only used for the static "Navigate Here" deep link, not the
# in-app map (that's Leaflet + CartoDB, no key needed)
VITE_GOOGLE_MAPS_KEY=

# Used by scripts/fill-transit-batch.cjs (Gemini) and data-enrichment scripts
GEMINI_API_KEY=

# Agoda affiliate — hotel cards / BaseCampCard
AGODA_CID=
AGODA_API_KEY=
