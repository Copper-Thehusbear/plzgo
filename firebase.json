{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "//trailingSlash": "Without this, Firebase 301s /explore -> /explore/ once the prerender creates a directory. Every internal link and the sitemap use the slashless form, so each one would cost a redirect hop and split canonicalisation.",
    "trailingSlash": false,
    "rewrites": [
      { "source": "/swipe", "destination": "/app.html" },
      { "source": "/route", "destination": "/app.html" },
      { "source": "/route/**", "destination": "/app.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "//headers": "Order matters: the catch-all is declared first so the specific rules below override it. Pages are served from directory paths (/explore), so a **/*.html glob would never match them.",
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "max-age=300, must-revalidate" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
      "runtime": "nodejs20"
    }
  ]
}
